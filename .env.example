# Copy to .env and fill in.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=
# Set to true when served over HTTPS
COOKIE_SECURE=false

EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu

# Leave empty if tesseract is on PATH. Windows default install:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGS=hin+eng

# JSON list, only needed if the chat is embedded on another site
CORS_ORIGINS=[]
CHAT_RATE_LIMIT=20/minute
